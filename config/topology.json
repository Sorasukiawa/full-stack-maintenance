{
  "version": 1,
  "workspace_roots": [],
  "worktree_hubs": [],
  "app_roots": [
    "/Applications",
    "~/Applications"
  ],
  "library_roots": [
    "~/Library/Application Support",
    "~/Library/Caches",
    "~/Library/Containers",
    "~/Library/Group Containers",
    "~/Library/Saved Application State",
    "~/Library/Logs",
    "~/Library/HTTPStorages",
    "~/Library/WebKit"
  ],
  "launch_agent_roots": [
    "~/Library/LaunchAgents",
    "/Library/LaunchAgents",
    "/Library/LaunchDaemons"
  ],
  "global_cache_roots": [
    "~/Library/Developer/Xcode/DerivedData",
    "~/Library/Caches/Homebrew",
    "~/.npm/_cacache",
    "~/.cache/uv",
    "~/.cache/pip",
    "~/Library/Caches/ms-playwright"
  ],
  "thresholds": {
    "min_orphan_mb": 50,
    "min_app_size_mb": 50,
    "unused_app_days": 90,
    "min_cache_mb": 200,
    "min_git_pack_mb": 100,
    "min_build_artifact_mb": 100,
    "recent_activity_minutes": 60,
    "worktree_protect_minutes": 2880
  },
  "quarantine": {
    "root_dirs": [
      "/Volumes/ExternalSSD/.Cleanup_Quarantine",
      "~/.Cleanup_Quarantine"
    ],
    "retention_days": 7
  },
  "storage_gauges": [
    {
      "id": "mac-data",
      "label": "Mac Data Volume",
      "mount_path": "/System/Volumes/Data",
      "warn_used_pct": 85.0
    }
  ],
  "backup_pipelines": [],
  "homelab": {
    "enabled": false,
    "pve_ssh_host": "",
    "nas_mounts": [],
    "docker_hosts": []
  },
  "whitelist": {
    "paths": [],
    "repos": [],
    "app_names": [],
    "guest_ids": [],
    "notes": {}
  }
}
